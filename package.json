{
  "name": "predge-rootstock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Predge agent-settlement stack on Rootstock \u2014 first x402-shaped facilitator on RSK.",
  "scripts": {
    "genwallet": "node script/genwallet.mjs",
    "deploy-usdc": "node script/deploy-usdc.mjs",
    "deploy-validator": "node script/deploy-validator.mjs",
    "deploy-bond": "node script/deploy-bond.mjs",
    "deploy-job": "node script/deploy-job.mjs",
    "deploy-all": "node script/deploy-usdc.mjs && node script/deploy-validator.mjs && node script/deploy-bond.mjs && node script/deploy-job.mjs",
    "demo": "node demo.mjs",
    "test": "node --test test/*.mjs",
    "test:sol": "forge test",
    "test:fork": "RSK_FORK=1 forge test --match-contract Fork -vv",
    "usdrif": "node script/usdrif-job.mjs",
    "bond": "node bond.mjs",
    "bond:demo": "node bond.mjs demo",
    "anchor": "node anchor.mjs",
    "anchor:demo": "node anchor.mjs demo",
    "deploy-anchor": "node script/deploy-anchor.mjs",
    "l402:demo": "node l402-bridge.mjs demo",
    "btc:genwallet": "node script/btc-genwallet.mjs",
    "btc:anchor": "node btc-anchor.mjs",
    "btc:anchor:dry": "node btc-anchor.mjs --dry-run"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@noble/secp256k1": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "ethers": "^6.13.4",
    "solc": "0.8.26"
  },
  "engines": {
    "node": ">=20"
  }
}
